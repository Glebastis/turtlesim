{
  "dashboard": {
    "title": "Turtles Monitoring",
    "panels": [
      {
        "title": "Active Turtles",
        "targets": [
          {
            "expr": "turtle_active_count",
            "legendFormat": "Active"
          },
          {
            "expr": "turtle_target_count",
            "legendFormat": "Target"
          }
        ]
      },
      {
        "title": "Spawn/Kill Rate",
        "targets": [
          {
            "expr": "rate(turtle_spawns_total[1m])",
            "legendFormat": "Spawns"
          },
          {
            "expr": "rate(turtle_prey_eaten_total[1m])",
            "legendFormat": "Eaten"
          }
        ]
      },
      {
        "title": "Latency Distribution",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(turtle_spawn_latency_ms_bucket[5m]))",
            "legendFormat": "Spawn (p95)"
          }
        ]
      }
    ]
  }
}