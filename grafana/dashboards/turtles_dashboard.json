{
  "uid": "turtles-main",
  "title": "Turtles Monitoring",
  "tags": ["turtles", "ros2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active vs Target Turtles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "turtle_active_count", "legendFormat": "Active", "refId": "A" },
        { "expr": "turtle_target_count", "legendFormat": "Target", "refId": "B" }
      ]
    },
    {
      "id": 2,
      "title": "Spawn / Kill rate (1m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(turtle_spawns_total[1m])", "legendFormat": "Spawns", "refId": "A" },
        { "expr": "rate(turtle_prey_eaten_total[1m])", "legendFormat": "Eaten", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "Spawn latency p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(turtle_spawn_latency_ms_bucket[5m]))", "legendFormat": "p95", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Errors total",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "turtle_errors_total", "legendFormat": "errors", "refId": "A" }
      ]
    }
  ]
}
